NODE_ENV=production
PORT=5000
WEB_PORT=3000
API_PROXY_TARGET=http://127.0.0.1:5000
UPLOADS_DIR=/app/uploads
DATA_FILE=/app/data/store.json
# Generate locally with: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
# Required for live IIA chat. Keep the real key on the server; never commit it.
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated fallback models enabled for this API key/project.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Khalti one-time access checkout. Keep the secret only in the server environment.
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox
PUBLIC_APP_URL=https://integratedia.duckdns.org
# Keep false until live Khalti verification and paid-access tests pass.
IIA_REQUIRE_PAID_ACCESS=false
# Set this to the exact public IIA Instagram profile URL before launch.
NEXT_PUBLIC_IIA_INSTAGRAM_URL=
